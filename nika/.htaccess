# Nika Music and Arts — Apache config for the built site.
#
# The journey is a single-page app using HTML5 history routing, so /guitar,
# /enroll and every other chapter are real URLs with no file behind them.
# Without the rewrite below, they 404 on direct load or refresh.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Deploying into a subdirectory (example.com/nika/)? Set this to /nika/ and
  # build with VITE_BASE=/nika/ so the asset URLs match.
  RewriteBase /

  # Serve real files and directories as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a chapter: hand it to the app.
  RewriteRule . index.html [L]
</IfModule>

# Asset filenames carry a content hash, so they can be cached hard.
# index.html must not be, or visitors keep booting a stale build.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|avif|png|jpg|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>
